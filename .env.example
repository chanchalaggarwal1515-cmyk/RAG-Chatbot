GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Local: copy this file to .env (gitignored).
# Streamlit Cloud: App settings → Secrets, paste:
#   GROQ_API_KEY = "gsk_your_key"
#   GROQ_MODEL = "openai/gpt-oss-20b"
# Render/Railway: set the same names as environment variables.
# .env is never uploaded, so the host has no key until you add secrets.
